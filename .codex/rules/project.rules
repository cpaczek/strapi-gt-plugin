prefix_rule(pattern = ["git", "push"], decision = "forbidden", match = ["git push origin main"])
prefix_rule(pattern = ["git", "remote", "add"], decision = "forbidden", match = ["git remote add origin https://example.invalid/project.git"])
prefix_rule(pattern = ["rm", ["-rf", "-fr"]], decision = "forbidden", match = ["rm -rf output"])
prefix_rule(pattern = ["rm", "-r", "-f"], decision = "forbidden")
prefix_rule(pattern = ["npm", "publish"], decision = "forbidden")
prefix_rule(pattern = ["pnpm", "publish"], decision = "forbidden")
prefix_rule(pattern = ["pnpm", ["install", "build", "test", "test:tooling", "test:coverage", "test:integration", "test:e2e", "test:packaging", "lint", "lint:fix", "typecheck", "format", "format:fix", "verify", "size"]], decision = "allow")
prefix_rule(pattern = ["pnpm", "--filter", ["strapi-plugin-general-translation", "@gt/playground", "@gt/reader", "@gt/acceptance"], ["build", "test", "typecheck", "lint", "format", "verify", "size", "develop", "dev", "mock", "test:integration", "test:e2e", "test:packaging"]], decision = "allow")
prefix_rule(pattern = ["pnpm", "exec", ["vitest", "playwright", "oxlint", "oxfmt"]], decision = "allow")
prefix_rule(pattern = ["vitest"], decision = "allow")
prefix_rule(pattern = ["playwright"], decision = "allow")
prefix_rule(pattern = ["git", ["status", "diff", "log", "show", "add", "commit", "merge", "rebase", "switch", "branch", "worktree"]], decision = "allow")
prefix_rule(pattern = ["git", "remote", "-v"], decision = "allow")
