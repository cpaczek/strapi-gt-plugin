{
  "name": "strapi-plugin-general-translation",
  "version": "0.1.0",
  "description": "Community plugin for translating localized Strapi content with General Translation.",
  "keywords": [
    "i18n",
    "strapi",
    "strapi-plugin",
    "translation"
  ],
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "commonjs",
  "exports": {
    "./package.json": "./package.json",
    "./strapi-admin": {
      "types": "./dist/admin/admin/src/index.d.ts",
      "source": "./admin/src/index.ts",
      "import": "./dist/admin/index.mjs",
      "require": "./dist/admin/index.js",
      "default": "./dist/admin/index.js"
    },
    "./strapi-server": {
      "types": "./dist/server/server/src/index.d.ts",
      "source": "./server/src/index.ts",
      "import": "./dist/server/index.mjs",
      "require": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    }
  },
  "scripts": {
    "build": "strapi-plugin build --minify",
    "verify": "strapi-plugin verify",
    "watch": "strapi-plugin watch",
    "test": "vitest run",
    "typecheck": "tsc -p server/tsconfig.json && tsc -p admin/tsconfig.json",
    "lint": "oxlint server admin shared tests",
    "format": "oxfmt --check server admin shared tests",
    "size": "size-limit"
  },
  "dependencies": {
    "@generaltranslation/api": "catalog:",
    "@generaltranslation/supported-locales": "catalog:",
    "generaltranslation": "catalog:",
    "mdast-util-from-markdown": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@size-limit/file": "catalog:",
    "@strapi/admin": "catalog:",
    "@strapi/content-manager": "catalog:",
    "@strapi/design-system": "catalog:",
    "@strapi/i18n": "catalog:",
    "@strapi/icons": "catalog:",
    "@strapi/sdk-plugin": "catalog:",
    "@strapi/strapi": "catalog:",
    "@strapi/types": "catalog:",
    "@strapi/typescript-utils": "catalog:",
    "@strapi/utils": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/koa": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "jsdom": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-intl": "catalog:",
    "react-router-dom": "catalog:",
    "size-limit": "catalog:",
    "styled-components": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@strapi/design-system": "^2.2.4",
    "@strapi/icons": "^2.2.4",
    "@strapi/strapi": "~5.57.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-intl": "^6.8.9",
    "react-router-dom": "^6.30.6",
    "styled-components": "^6.5.3"
  },
  "size-limit": [
    {
      "path": "dist/admin/*.mjs",
      "limit": "65 kB"
    }
  ],
  "engines": {
    "node": ">=22.12.0 <=26.x.x"
  },
  "strapi": {
    "kind": "plugin",
    "name": "general-translation",
    "displayName": "General Translation",
    "description": "Translate localized content with your General Translation account."
  }
}
