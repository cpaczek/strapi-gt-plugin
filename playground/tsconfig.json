{
  "compilerOptions": {
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["ES2022"],
    "target": "ES2022",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmitOnError": true,
    "noImplicitThis": true,
    "outDir": "dist",
    "rootDir": "."
  },
  "include": ["config/**/*.ts", "src/**/*.ts", "src/**/*.json", "types/**/*.d.ts"],
  "exclude": ["node_modules", "dist", "build", ".tmp", ".strapi", "src/admin"]
}
