{
  "name": "strapi-general-translation-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "test": "pnpm test:tooling && turbo run test",
    "test:tooling": "vitest run --config vitest.tooling.config.ts",
    "typecheck": "turbo run typecheck",
    "lint": "node scripts/check-defaults.mjs && node scripts/check-prose.mjs && oxlint scripts && turbo run lint",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt --write .",
    "verify": "pnpm --filter strapi-plugin-general-translation verify",
    "size": "pnpm --filter strapi-plugin-general-translation size",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "prepare": "lefthook install",
    "test:coverage": "pnpm --filter strapi-plugin-general-translation exec vitest run --coverage",
    "test:integration": "pnpm --filter @gt/acceptance test:integration",
    "test:e2e": "pnpm --filter @gt/acceptance test:e2e",
    "test:packaging": "pnpm --filter @gt/acceptance test:packaging",
    "demo": "node scripts/testbed/demo.mjs",
    "release-packages": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "lefthook": "catalog:",
    "oxc-parser": "0.153.0",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22.12.0 <=26.x.x"
  },
  "packageManager": "pnpm@12.11.2"
}
